<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     PyRecT3D — Android 清单占位（需按实际工程修改）
     包名 / SDK 版本 / 权限 均为占位值
     ============================================================ -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.pyrect3d.runtime">

    <!-- 引擎只做本地渲染，默认不需要网络；
         若要从网络加载资源/视频，解除下一行注释 -->
    <!-- <uses-permission android:name="android.permission.INTERNET" /> -->

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="PyRecT3D"
        android:hasCode="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data android:name="pyrect3d.backend" android:value="GLES3" />
        <meta-data android:name="pyrect3d.libName" android:value="libPyRecT3D.so" />
    </application>
</manifest>
